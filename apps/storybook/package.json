{
  "name": "@komzot/storybook",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "storybook dev -p 6006 --no-open",
    "build:storybook": "storybook build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project=storybook",
    "test:watch": "vitest --project=storybook",
    "test:coverage": "vitest run --project=storybook --coverage",
    "clean": "rm -rf storybook-static coverage test-results"
  },
  "dependencies": {
    "@komzot/ui": "*",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@komzot/eslint-config": "*",
    "@komzot/typescript-config": "*",
    "@storybook/addon-a11y": "^10.6.6",
    "@storybook/addon-docs": "^10.6.6",
    "@storybook/addon-vitest": "^10.6.6",
    "@storybook/react-vite": "^10.6.6",
    "@types/node": "^22.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.0.0",
    "storybook": "^10.6.6",
    "typescript": "^5",
    "vite": "^8.0.0",
    "vitest": "^5.1.0",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "playwright": "^1.65.0"
  }
}
