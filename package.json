{
  "name": "komzot",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@11.19.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=web",
    "dev:mobile": "turbo run dev --filter=mobile",
    "dev:storybook": "turbo run dev --filter=@komzot/storybook",
    "storybook:web": "npm run dev -w @komzot/storybook",
    "storybook:mobile": "npm run storybook -w apps/mobile",
    "storybook:ios": "npm run storybook:ios -w apps/mobile",
    "storybook:android": "npm run storybook:android -w apps/mobile",
    "build": "turbo run build build:storybook",
    "build:storybook": "turbo run build:storybook",
    "test": "turbo run test",
    "test:web": "turbo run test --filter=web",
    "test:mobile": "turbo run test --filter=mobile",
    "test:storybook": "turbo run test --filter=@komzot/storybook",
    "test:coverage": "turbo run test:coverage",
    "test:e2e": "npm run db:generate && npm run test:e2e -w apps/web",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:generate": "npm run generate -w @komzot/db",
    "db:migrate": "npm run migrate -w @komzot/db",
    "db:migrate:deploy": "npm run migrate:deploy -w @komzot/db",
    "db:studio": "npm run studio -w @komzot/db",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "turbo": "^2.11.10"
  },
  "overrides": {
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-community/slider": "5.2.1",
    "react-native-svg": "15.16.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
